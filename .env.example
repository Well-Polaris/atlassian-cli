# Atlassian API Configuration
# Copy this file to .env and fill in your values

# Your Atlassian site URL (e.g., https://yoursite.atlassian.net)
ATLASSIAN_SITE_URL=

# Cloud ID (UUID) - can be obtained via API or from URLs
ATLASSIAN_CLOUD_ID=

# REST API Authentication (for Jira/Confluence)
ATLASSIAN_EMAIL=
ATLASSIAN_API_TOKEN=

# OAuth 2.0 (required for GraphQL APIs - Goals, Projects)
ATLASSIAN_CLIENT_ID=
ATLASSIAN_CLIENT_SECRET=
ATLASSIAN_ACCESS_TOKEN=
ATLASSIAN_REFRESH_TOKEN=
